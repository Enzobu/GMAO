{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Types de pièces{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">Types de pièces</h1>
        <div class="text-body-secondary small">
          Configuration des catégories de pièces utilisées dans le stock.
        </div>
      </div>

      <a class="btn btn-primary" href="{{ path('app_configuration_part_type_new') }}">
        {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
        Ajouter un type
      </a>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        {% if part_types|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Nom</th>
                  <th>Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for part_type in part_types %}
                  <tr>
                    <td class="fw-semibold">
                      {{ part_type.name }}
                    </td>
                    <td class="text-body-secondary">
                      {{ part_type.description ?: '—' }}
                    </td>
                    <td>
                      <div class="d-flex justify-content-end gap-2">
                        <a
                          class="btn btn-sm btn-outline-secondary"
                          href="{{ path('app_configuration_part_type_show', { id: part_type.id }) }}"
                        >
                          {{ fa.icon('eye', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
                          Voir
                        </a>

                        <a
                          class="btn btn-sm btn-outline-primary"
                          href="{{ path('app_configuration_part_type_edit', { id: part_type.id }) }}"
                        >
                          {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
                          Modifier
                        </a>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="text-center py-5">
            <div class="mb-2">
              {{ fa.icon('atom', family: 'solid', fixed_width: true, additional_classes: ['fs-3', 'text-body-secondary']) }}
            </div>

            <div class="fw-semibold">Aucun type de pièce</div>

            <div class="text-body-secondary small mb-3">
              Commence par créer un type de pièce.
            </div>

            <a class="btn btn-primary" href="{{ path('app_configuration_part_type_new') }}">
              {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
              Ajouter un type
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}