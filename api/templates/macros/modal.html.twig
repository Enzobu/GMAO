{% macro confirm(
  id,
  title,
  description = null,
  continueButton = null,
  cancelButton = 'Annuler',
  type = 'button',
  accent = 'primary',
  href = null,
  action = null,
  method = 'post',
  csrfToken = null,
  csrfFieldName = '_token',
  _route = null,
  _entity_id = null,
  formId = null,
  buttonName = null,
  buttonValue = null,
  autoShow = false,
) %}

  <div class="modal fade"
       id="{{ id }}"
       data-bs-backdrop="static"
       data-bs-keyboard="false"
       tabindex="-1"
       aria-labelledby="{{ id }}Label"
       aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="{{ id }}Label">{{ title }}</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>

        {% if description %}
          <div class="modal-body">
            {% if description %}
              <div class="text-body-secondary">
                {{ description|raw }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if cancelButton or continueButton %}
          <div class="modal-footer">
            {% if cancelButton %}
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                {{ cancelButton }}
              </button>
            {% endif %}

            {% if continueButton %}
              {% if type == 'submit' and formId %}
                <button
                  type="submit"
                  form="{{ formId }}"
                  class="btn btn-{{ accent }}"
                  {% if buttonName %}name="{{ buttonName }}"{% endif %}
                  {% if buttonValue is not null %}value="{{ buttonValue }}"{% endif %}
                >
                  {{ continueButton }}
                </button>
              {% elseif type == 'submit' %}
                <form method="{{ method }}" action="{{ action }}" class="m-0">
                  {% if csrfToken %}
                    <input type="hidden" name="{{ csrfFieldName }}" value="{{ csrfToken }}">
                  {% endif %}
                  {% if _route %}
                    <input type="hidden" name="_route" value="{{ _route }}">
                  {% endif %}
                  {% if _entity_id %}
                    <input type="hidden" name="_entity_id" value="{{ _entity_id }}">
                  {% endif %}

                  <button type="submit" class="btn btn-{{ accent }}">
                    {{ continueButton }}
                  </button>
                </form>
              {% else %}
                <a href="{{ href }}" class="btn btn-{{ accent }}">
                  {{ continueButton }}
                </a>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if autoShow %}
    <script>
      (() => {
        const showModal = () => {
          const modalElement = document.getElementById('{{ id }}');

          if (!modalElement || !window.bootstrap) {
            return;
          }

          window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', showModal, { once: true });
        } else {
          showModal();
        }

        document.addEventListener('turbo:load', showModal, { once: true });
      })();
    </script>
  {% endif %}
{% endmacro %}

{% macro mileage_warning(id, formId, warning, title = 'Kilométrage incohérent') %}
  {% import _self as modal %}

  {% set description %}
    <p class="mb-2">
      Cette modification n’augmente pas le dernier kilométrage connu du véhicule.
    </p>

    <div class="border rounded p-3 my-3">
      <div class="d-flex justify-content-between gap-3">
        <span>Dernier kilométrage connu</span>
        <strong>{{ warning.currentMileage|number_format(0, ',', ' ') }} km</strong>
      </div>

      <div class="d-flex justify-content-between gap-3 mt-2">
        <span>Kilométrage saisi</span>
        <strong>{{ warning.submittedMileage|number_format(0, ',', ' ') }} km</strong>
      </div>
    </div>

    <p class="mb-0">
      En forçant, l’élément sera enregistré. Le kilométrage du véhicule ne sera mis à jour que si cette valeur devient la plus élevée connue.
    </p>
  {% endset %}

  {{ modal.confirm(
    id: id,
    title: title,
    description: description,
    continueButton: 'Forcer l’enregistrement',
    cancelButton: 'Corriger',
    type: 'submit',
    accent: 'warning',
    formId: formId,
    buttonName: constant('App\\Service\\VehicleManager::FORCE_MILEAGE_FIELD'),
    buttonValue: '1',
    autoShow: true,
  ) }}
{% endmacro %}
