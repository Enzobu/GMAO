{% extends 'base.html.twig' %}

{% import "macros/badge.html.twig" as badge %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}

  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h1 class="h3 mb-1">Utilisateurs</h1>
      <div class="text-body-secondary small">{{ users|length }} utilisateur(s)</div>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
      <a class="btn btn-primary" href="{{ path('app_user_new') }}">
        {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
        Ajouter un utilisateur
      </a>
    {% endif %}
  </div>

  {% if users is empty %}
    <div class="alert alert-info">
      Aucun utilisateur pour le moment.
    </div>
  {% else %}
    <div class="row g-3">
      {% for user in users %}
        {% set isCurrentUser = app.user and user.id == app.user.id %}
        {% set readOnly = is_granted('ROLE_ADMIN') ? false : user.id != app.user.id %}

        <div class="col-12 col-xl-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-start justify-content-between gap-3">
                <div class="w-100">
                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2 class="h5 mb-0">
                      {{ user.displayName }}
                    </h2>

                    {% if 'ROLE_ADMIN' in user.roles %}
                      {{ badge.default(label: 'Administrateur', variant: 'danger') }}
                    {% else %}
                      {{ badge.default(label: 'Utilisateur', variant: 'secondary') }}
                    {% endif %}

                    {% if isCurrentUser %}
                      {{ badge.emphasis(label: 'Vous', variant: 'primary') }}
                    {% endif %}
                  </div>

                  <div class="text-body-secondary small mt-1">
                    <span class="me-3">
                      <strong>Email : </strong> <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                    </span>
                  </div>
                </div>

                <div class="d-flex gap-2 flex-shrink-0">
                  <a
                    class="btn btn-sm {{ readOnly ? 'btn-outline-warning' : 'btn-outline-secondary' }}"
                    {% if readOnly %}
                      href="{{ path('app_user_show', {id: user.id}) }}"
                      data-bs-toggle="tooltip"
                      data-bs-placement="top"
                      data-bs-custom-class="custom-tooltip"
                      data-bs-title="Lecture seule"
                    {% else %}
                      {% if isCurrentUser %}
                        href="{{ path('app_profile') }}?user-list=true"
                      {% else %}
                        href="{{ path('app_user_show', {id: user.id}) }}"
                      {% endif %}
                      
                    {% endif %}
                  >
                    {{ fa.icon('eye', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
                    Voir
                  </a>
                </div>
              </div>
            </div>

            <div class="card-footer bg-body d-flex justify-content-end">
              <a class="btn btn-sm btn-outline-primary d-flex align-items-center me-2 {{ readOnly ? 'btn-outline-disable' }}"
                {% if not readOnly %}href="{{ isCurrentUser ? path('app_profile') : path('app_user_edit', {id: user.id}) }}{{ isCurrentUser ? "?user-list=true" }}"{% endif %}>
                  {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
                  Modifier
              </a>
              {% if is_granted('ROLE_ADMIN') %}
                {% include "user/_delete_form.html.twig" %}
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}