{% extends 'base.html.twig' %}

{% import "macros/fontawesome.html.twig" as fa %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <h1 class="h3 mb-1">
          Modifier {{ (user.firstname ~ ' ' ~ user.lastname)|trim ?: user.email }}
        </h1>
        <div class="text-body-secondary small">Utilisateur #{{ user.id }}</div>
      </div>
    </div>

    {{ include('user/_form.html.twig', { button_label: 'Mettre à jour' }) }}
  </div>
{% endblock %}