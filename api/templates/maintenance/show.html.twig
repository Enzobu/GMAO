{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/document.html.twig' as document %}
{% import 'macros/badge.html.twig' as badge %}

{% block title %}Entretien{% endblock %}

{% block body %}
  {% set vehicleContext = vehicle_context|default(false) %}
  {% set canEdit = is_granted('ROLE_ADMIN') or (vehicleContext and maintenance.vehicle.user == app.user) %}
  {% set readOnly = not canEdit %}

  <div class="container py-4 py-lg-5">
    <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 mb-4">
      <div>
        <div class="text-body-secondary small mb-1">Entretien</div>
        <h1 class="h3 mb-2">
          {{ maintenance.maintenanceType.name }}
        </h1>

        <div class="d-flex flex-wrap align-items-center gap-2">
          {{ badge.emphasis(
            label: maintenance.status.label,
            variant: maintenance.status.variant
          ) }}

          {{ badge.emphasis(
            maintenance.isExternal ? 'Externe' : 'Interne',
            maintenance.isExternal ? 'info' : 'secondary'
          ) }}

          {{ badge.emphasis(maintenance.maintenanceType.name, 'info') }}
        </div>

        <div class="text-body-secondary small mt-2">
          Véhicule :
          <span class="fw-semibold text-body">{{ maintenance.vehicle.displayName }}</span>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a
          class="btn btn-outline-secondary"
          href="{{
            vehicleContext
              ? path('app_vehicle_maintenance_index', {vehicleId: maintenance.vehicle.id})
              : path('app_maintenance_index')
          }}"
        >
          {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
          Retour
        </a>

        <a
          class="btn btn-primary {{ readOnly ? 'btn-disable' }}"
          {% if not readOnly %}
            href="{{
              vehicleContext
                ? path('app_vehicle_maintenance_edit', {vehicleId: maintenance.vehicle.id, id: maintenance.id}) ~ '?show=true'
                : path('app_maintenance_edit', {'id': maintenance.id}) ~ '?show=true'
            }}"
          {% endif %}
        >
          {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
          Modifier
        </a>

        {% if is_granted('ROLE_ADMIN') %}
          {{ include('maintenance/_delete_form.html.twig') }}
        {% endif %}
      </div>
    </div>

    <div class="row g-4">
      <div class="col-12">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <div class="row g-3">
              <div class="col-6 col-md-4 col-xl">
                <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                  <div class="small text-body-secondary mb-1">Kilométrage</div>
                  <div class="fw-semibold fs-5">
                    {{ maintenance.mileage is not null ? maintenance.mileage|number_format(0, ',', ' ') ~ ' km' : '—' }}
                  </div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-xl">
                <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                  <div class="small text-body-secondary mb-1">Statut</div>
                  <div class="fw-semibold">
                    {{ badge.emphasis(
                      label: maintenance.status.label,
                      variant: maintenance.status.variant
                    ) }}
                  </div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-xl">
                <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                  <div class="small text-body-secondary mb-1">Mode</div>
                  <div class="fw-semibold">
                    {{ badge.emphasis(
                      maintenance.isExternal ? 'Externe' : 'Interne',
                      maintenance.isExternal ? 'info' : 'secondary'
                    ) }}
                  </div>
                </div>
              </div>

              <div class="col-6 col-md-6 col-xl">
                <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                  <div class="small text-body-secondary mb-1">Prévu le</div>
                  <div class="fw-semibold">
                    {{ maintenance.plannedAt ? maintenance.plannedAt|date('d/m/Y H:i') : '—' }}
                  </div>
                </div>
              </div>

              <div class="col-6 col-md-6 col-xl">
                <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                  <div class="small text-body-secondary mb-1">Terminé le</div>
                  <div class="fw-semibold">
                    {{ maintenance.finishedAt ? maintenance.finishedAt|date('d/m/Y H:i') : '—' }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-4">
              {{ fa.icon('car-side', family: 'solid', fixed_width: true, additional_classes: ['text-primary']) }}
              <h2 class="h5 mb-0">Véhicule</h2>
            </div>

            <div class="border rounded-3 p-3 bg-body-tertiary">
              <div class="fw-semibold mb-1">{{ maintenance.vehicle.displayName }}</div>

              <div class="small text-body-secondary">
                {{ maintenance.vehicle.registration ? maintenance.vehicle.registration|upper : 'Immatriculation non renseignée' }}
              </div>

              {% if maintenance.vehicle.brand or maintenance.vehicle.model %}
                <div class="small text-body-secondary mt-2">
                  {{ maintenance.vehicle.brand }} {{ maintenance.vehicle.model }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-4">
              {{ fa.icon('calendar-days', family: 'solid', fixed_width: true, additional_classes: ['text-primary']) }}
              <h2 class="h5 mb-0">Planification</h2>
            </div>

            <div class="d-flex flex-column gap-3">
              <div class="border rounded-3 p-3">
                <div class="small text-body-secondary mb-1">Date prévue</div>
                <div class="fw-semibold">
                  {{ maintenance.plannedAt ? maintenance.plannedAt|date('d/m/Y H:i') : '—' }}
                </div>
              </div>

              <div class="border rounded-3 p-3">
                <div class="small text-body-secondary mb-1">Date de fin</div>
                <div class="fw-semibold">
                  {{ maintenance.finishedAt ? maintenance.finishedAt|date('d/m/Y H:i') : '—' }}
                </div>
              </div>

              <div class="border rounded-3 p-3">
                <div class="small text-body-secondary mb-1">Type d’entretien</div>
                <div class="fw-semibold">
                  {{ badge.emphasis(maintenance.maintenanceType.name, 'info') }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-4">
              {{ fa.icon('gauge-high', family: 'solid', fixed_width: true, additional_classes: ['text-primary']) }}
              <h2 class="h5 mb-0">Échéances</h2>
            </div>

            <div class="d-flex flex-column gap-3">
              <div class="border rounded-3 p-3">
                <div class="small text-body-secondary mb-1">Prochaine échéance kilométrique</div>
                <div class="fw-semibold">
                  {{ maintenance.nextDueMileage is not null ? maintenance.nextDueMileage|number_format(0, ',', ' ') ~ ' km' : '—' }}
                </div>
              </div>

              <div class="border rounded-3 p-3">
                <div class="small text-body-secondary mb-1">Prochaine échéance date</div>
                <div class="fw-semibold">
                  {{ maintenance.nextDueAt ? maintenance.nextDueAt|date('d/m/Y H:i') : '—' }}
                </div>
              </div>

              <div class="border rounded-3 p-3">
                <div class="small text-body-secondary mb-1">Kilométrage de l’intervention</div>
                <div class="fw-semibold">
                  {{ maintenance.mileage is not null ? maintenance.mileage|number_format(0, ',', ' ') ~ ' km' : '—' }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-8">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-4">
              {{ fa.icon('boxes-stacked', family: 'solid', fixed_width: true, additional_classes: ['text-primary']) }}
              <h2 class="h5 mb-0">Pièces utilisées</h2>
            </div>

            {% if maintenance.maintenanceParts|length > 0 %}
              <div class="row g-3">
                {% for maintenancePart in maintenance.maintenanceParts %}
                  <div class="col-12">
                    <div class="border rounded-3 p-3 h-100">
                      <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3">
                        <div>
                          <div class="fw-semibold">
                            {{ maintenancePart.part.partType.name }}
                          </div>

                          {% if maintenancePart.notes %}
                            <div class="small text-body-secondary mt-1">
                              {{ maintenancePart.notes }}
                            </div>
                          {% endif %}
                        </div>

                        <div class="d-flex align-items-center gap-2">
                          {{ badge.emphasis('x' ~ maintenancePart.quantity, 'primary') }}
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="border rounded-3 p-3 bg-body-tertiary text-body-secondary small">
                Aucune pièce renseignée pour cet entretien.
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-4">
              {{ fa.icon('note-sticky', family: 'solid', fixed_width: true, additional_classes: ['text-primary']) }}
              <h2 class="h5 mb-0">Notes</h2>
            </div>

            <div class="border rounded-3 p-3 bg-body-tertiary h-100">
              {% if maintenance.notes %}
                <div class="text-body">
                  {{ maintenance.notes|nl2br }}
                </div>
              {% else %}
                <div class="text-body-secondary small">
                  Aucune note renseignée.
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="col-12">
        {{ document.list(
          documents: maintenance_document,
          newPath: path('app_maintenance_document_new', {id: maintenance.id}),
          sourceRoute: vehicleContext
            ? path('app_vehicle_maintenance_show', {vehicleId: maintenance.vehicle.id, id: maintenance.id})
            : path('app_maintenance_show', {id: maintenance.id}),
          editRoute: 'app_maintenance_document_edit',
          editParameters: {id: maintenance.id},
          deleteRoute: 'app_maintenance_document_delete',
          deleteParameters: {id: maintenance.id},
          fallback: 'Aucun document disponible pour cette maintenance.',
          readOnly: readOnly,
        ) }}
      </div>
    </div>
  </div>
{% endblock %}
