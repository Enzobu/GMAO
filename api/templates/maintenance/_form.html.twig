{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/modal.html.twig' as modal %}

{{ form_start(form, {
  attr: {
    id: 'maintenance-form',
    'data-turbo': 'false',
  }
}) }}
  <div class="row g-3">
    {% if form.vehicle is defined %}
      <div class="col-md-6">
        {{ form_row(form.vehicle) }}
      </div>
    {% endif %}
    <div class="{{ form.vehicle is defined ? 'col-md-6' : 'col-12' }}">
      {{ form_row(form.maintenanceType) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.status) }}
    </div>
    <div class="col-md-6">
      {{ form_row(form.mileage) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.plannedAt) }}
    </div>
    <div class="col-md-6">
      {{ form_row(form.startedAt) }}
    </div>
    <div class="col-md-6">
      {{ form_row(form.finishedAt) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.nextDueMileage) }}
    </div>
    <div class="col-md-6">
      {{ form_row(form.nextDueAt) }}
    </div>

    <div class="col-12">
      {{ form_row(form.isExternal) }}
    </div>

    <div class="col-12">
      {{ form_row(form.notes) }}
    </div>
  </div>

  <div
    class="mt-4"
    {{ stimulus_controller('form-collection') }}
    data-form-collection-index-value="{{ (form.maintenanceParts|length) > 0 ? form.maintenanceParts|last.vars.name + 1 : 0 }}"
    data-form-collection-prototype-value="{{ form_widget(form.maintenanceParts.vars.prototype)|e('html_attr') }}"
  >
    <div class="d-flex align-items-center mb-2">
      <h3 class="mb-0">Pièces</h3>
      <a class="ms-auto me-0" type="button" {{ stimulus_action('form-collection', 'addCollectionElement') }}>
        {{ fa.icon('plus', size: 'lg') }}
      </a>
    </div>

    <ul class="features list-unstyled ps-0" {{ stimulus_target('form-collection', 'collectionContainer') }}>
      {% for maintenancePart in form.maintenanceParts %}
        <div class="mb-3 row align-items-center">
          <li class="col">
            <div class="row g-3">
              <div class="col-md-8">
                {{ form_row(maintenancePart.part) }}
              </div>
              <div class="col-md-4">
                {{ form_row(maintenancePart.quantity) }}
              </div>
            </div>
          </li>
        </div>
      {% endfor %}
    </ul>
  </div>

  <div class="text-end">
    <button type="submit" class="btn btn-primary">
      {{ fa.icon('save') }}
      {{ button_label|default('Enregistrer') }}
    </button>
  </div>
{{ form_end(form) }}

{% if mileage_warning|default(null) %}
  {{ modal.mileage_warning(
    id: 'maintenanceMileageWarningModal',
    formId: 'maintenance-form',
    warning: mileage_warning,
  ) }}
{% endif %}
