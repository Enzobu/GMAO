{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Nouvel entretien{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">Nouvel entretien</h1>
        <div class="text-body-secondary small">
          Ajoute un nouvel entretien à un véhicule.
        </div>
      </div>

      <a class="btn btn-outline-secondary" href="{{ path('app_maintenance_index') }}">
        {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
        Retour à la liste
      </a>
    </div>

    {{ include('maintenance/_form.html.twig') }}
  </div>
{% endblock %}