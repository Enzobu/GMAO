<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rappel d'échéance</title>
  </head>
  <body style="margin:0; padding:0; background:#f4f4f5; font-family:Arial, Helvetica, sans-serif; color:#18181b;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f4f5; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px; background:#ffffff; border:1px solid #e4e4e7; border-radius:28px; overflow:hidden; box-shadow:0 20px 50px rgba(24, 24, 27, 0.08);">
            <tr>
              <td style="padding:32px 32px 20px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="vertical-align:middle;">
                      <div style="display:inline-block; width:52px; height:52px; border-radius:18px; background:#18181b; text-align:center; line-height:52px; color:#ffffff; font-size:24px; font-weight:700;">
                        🔧
                      </div>
                    </td>
                    <td align="right" style="vertical-align:middle; color:#71717a; font-size:13px;">
                      GMAO
                    </td>
                  </tr>
                </table>

                <h1 style="margin:28px 0 12px; color:#18181b; font-size:28px; line-height:1.2; letter-spacing:-0.02em;">
                  Rappel d'échéance
                </h1>

                <p style="margin:0; color:#52525b; font-size:16px; line-height:1.6;">
                  Bonjour {{ user.firstname|capitalize }} {{ user.lastname|upper }},
                </p>

                <p style="margin:16px 0 0; color:#52525b; font-size:16px; line-height:1.6;">
                  Nous vous rappelons que {{ reminder.type }} de votre
                  {{ reminder.vehicle.name|capitalize }} arrive à son échéance
                  dans {{ reminder.timeToDeadline }} (date d'échéance :
                  <strong style="color:#18181b;">{{ reminder.deadline }}</strong>).
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:8px 32px 28px;">
                <a href="{{ reminder.cta.link }}" style="display:block; width:100%; box-sizing:border-box; padding:16px 22px; border-radius:16px; background:#18181b; color:#ffffff; font-size:15px; font-weight:700; text-align:center; text-decoration:none;">
                  Consulter la page {{ reminder.cta.label }}
                </a>
              </td>
            </tr>

            <tr>
              <td style="padding:0 32px 28px;">
                  <p style="margin:12px 0 0; color:#71717a; font-size:14px; line-height:1.6;">
                    Mécaniquement,<br>
                    L'équipe GMAO.
                  </p>
              </td>
            </tr>

            <tr>
              <td style="padding:22px 32px; background:#fafafa; border-top:1px solid #e4e4e7;">
                <p style="margin:0; color:#71717a; font-size:12px; line-height:1.5; text-align:center;">
                  Email automatique envoyé par GMAO. Ne répondez pas à ce message.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
