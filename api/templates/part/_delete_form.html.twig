{% import 'macros/modal.html.twig' as modal %}
{% import 'macros/fontawesome.html.twig' as fa %}

<button type="button"
  class="btn btn-outline-danger"
  data-bs-toggle="modal"
  data-bs-target="#deletePartModal{{ part.id }}"
>
  {{ fa.icon('trash-can', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
  Supprimer
</button>

{{ modal.confirm(
  id: 'deletePartModal' ~ part.id,
  title: 'Supprimer le stock de pièces ?',
  description: '
    <p class="mb-2">Vous êtes sur le point de supprimer ce contrôle technique :</p>
    <div class="fw-semibold">Pièce : ' ~ (part.partType.name|capitalize) ~ '</div>
    <p class="mt-3 mb-0 text-danger">Cette action est définitive.</p>
  ',
  continueButton: 'Supprimer',
  cancelButton: 'Annuler',
  type: 'submit',
  accent: 'danger',
  action: path('app_part_delete', { id: part.id }),
  csrfToken: csrf_token('delete' ~ part.id)
) }}