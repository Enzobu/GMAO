{% import 'macros/modal.html.twig' as modal %}
{% import 'macros/fontawesome.html.twig' as fa %}

<button
  type="button"
  class="btn btn-sm btn-outline-danger"
  data-bs-toggle="modal"
  data-bs-target="#deleteMaintenanceTypeModal{{ maintenance_type.id }}"
>
  {{ fa.icon('trash-can', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
  Supprimer
</button>

{{ modal.confirm(
  id: 'deleteMaintenanceTypeModal' ~ maintenance_type.id,
  title: 'Supprimer le type d’entretien ?',
  description: '
    <p class="mb-2">Vous êtes sur le point de supprimer :</p>
    <div class="fw-semibold">' ~ maintenance_type.name ~ '</div>
    <p class="mt-3 mb-0 text-danger">Ce type ne sera plus proposé dans les formulaires, mais restera visible sur les entretiens existants.</p>
  ',
  continueButton: 'Supprimer',
  cancelButton: 'Annuler',
  type: 'submit',
  accent: 'danger',
  action: path('app_configuration_maintenance_type_delete', { id: maintenance_type.id }),
  csrfToken: csrf_token('delete' ~ maintenance_type.id)
) }}
