{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-3"></div>
        <div class="col-6">
            <div class="d-flex flex-column">
                <h1 class="text-center mb-5">Profil</h1>

                {% include "_flashes.html.twig" %}
                {{ form_start(form) }}
                    <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                        <label for="{{ form.email.vars.id }}" class="mb-0 text-nowrap">E-mail :</label>
                        {{ form_row(form.email) }}
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                        <label for="{{ form.old_password.vars.id }}" class="mb-0 text-nowrap">Ancien mot de passe :</label>
                        {{ form_row(form.old_password) }}
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                        <label for="{{ form.new_password.vars.id }}" class="mb-0 text-nowrap">Nouveau mot de passe :</label>
                        {{ form_row(form.new_password) }}
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                        <label for="{{ form.new_password_retry.vars.id }}" class="mb-0 text-nowrap">Nouveau mot de passe :</label>
                        {{ form_row(form.new_password_retry) }}
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                        <label for="{{ form.firstname.vars.id }}" class="mb-0 text-nowrap">Prénom :</label>
                        {{ form_row(form.firstname) }}
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                        <label for="{{ form.lastname.vars.id }}" class="mb-0 text-nowrap">Nom :</label>
                        {{ form_row(form.lastname) }}
                    </div>

                    <div class="text-center">
                        <button class="btn btn-primary mt-3" type="submit">
                            Enregistrer
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
        <div class="col-3"></div>
    </div>
</div>
{% endblock %}
