{% extends 'base.html.twig' %}
{% import 'macros/document.html.twig' as document %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Profil{% endblock %}

{% block body %}
  {% set user_list = app.request.get('user-list') == 'true' %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">Profil</h1>
        <div class="text-body-secondary small">
          Gère tes informations personnelles.
        </div>
      </div>
      <a class="btn btn-outline-secondary" href="{{ path(user_list ? 'app_user_index' : 'app_home') }}">
        {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
        Retour
      </a>
    </div>

    {{ include('profile/_form.html.twig') }}

    <div class="mt-4">
      {{ document.list(
        documents: user_document,
        newPath: path('app_profile_document_new'),
        sourceRoute: path(app.request.attributes.get('_route')),
        editRoute: 'app_profile_document_edit',
        editParameters: {},
        deleteRoute: 'app_profile_document_delete',
        deleteParameters: {},
        fallback: "Aucun document disponible pour cet utilisateur",
        readOnly = false,
      ) }}
    </div>
  </div>
{% endblock %}