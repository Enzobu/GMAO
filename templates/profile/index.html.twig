{% extends 'base.html.twig' %}
{% import 'macros/document.html.twig' as document %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Profil{% endblock %}

{% block body %}
  {% set user_list = app.request.get('user-list') == 'true' %}
  <div class="container py-4 py-lg-5">
    <div class="mb-4">
      <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3">

        <div class="flex-grow-1 min-w-0">
          <h1 class="h3 mb-1">Profil</h1>

          <div class="text-body-secondary small d-none d-lg-block">
            Gère tes informations personnelles.
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 flex-shrink-0">
          <a
            class="btn btn-outline-secondary"
            href="{{ path(user_list ? 'app_user_index' : 'app_home') }}"
          >
            {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
            Retour
          </a>

          <form method="post" action="{{ path('app_profile_password_reset_request') }}" class="d-flex">
            <input type="hidden" name="_token" value="{{ csrf_token('profile_password_reset_request') }}">
            <button type="submit" class="btn btn-outline-primary w-100">
              Réinitialiser mon mot de passe
            </button>
          </form>
        </div>

      </div>
    </div>

    {{ include('profile/_form.html.twig') }}

    <div class="mt-4">
      {{ document.list(
        documents: user_document,
        newPath: path('app_profile_document_new'),
        sourceRoute: path(app.request.attributes.get('_route')),
        editRoute: 'app_profile_document_edit',
        editParameters: {},
        deleteRoute: 'app_profile_document_delete',
        deleteParameters: {},
        fallback: "Aucun document disponible pour cet utilisateur",
        readOnly = false,
      ) }}
    </div>
  </div>
{% endblock %}