{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
<div class="container py-4 py-lg-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">

      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h1 class="h3 mb-1">Profil</h1>
          <div class="text-body-secondary small">Gère tes informations et ton mot de passe.</div>
        </div>
      </div>

      {% include "_flashes.html.twig" %}

      <div class="card shadow-sm border-0">
        <div class="card-body py-2 px-4 py-lg-2 px-lg-5">
          {{ form_start(form, { attr: { class: 'needs-validation' } }) }}

            <div class="mb-4">
              <h2 class="h6 mb-3 text-uppercase text-body-secondary">Informations</h2>

              <div class="row g-3">
                <div class="col-12">
                  {{ form_row(form.email, {
                    label: 'E-mail',
                    row_attr: { class: 'mb-0' },
                    attr: { class: 'form-control', autocomplete: 'email' }
                  }) }}
                </div>

                <div class="col-12 col-md-6">
                  {{ form_row(form.firstname, {
                    label: 'Prénom',
                    row_attr: { class: 'mb-0' },
                    attr: { class: 'form-control', autocomplete: 'given-name' }
                  }) }}
                </div>

                <div class="col-12 col-md-6">
                  {{ form_row(form.lastname, {
                    label: 'Nom',
                    row_attr: { class: 'mb-0' },
                    attr: { class: 'form-control', autocomplete: 'family-name' }
                  }) }}
                </div>
              </div>
            </div>

            <hr class="my-4">

            <div class="mb-0">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h6 mb-0 text-uppercase text-body-secondary">Mot de passe</h2>
                <span class="badge text-bg-light">Optionnel</span>
              </div>

              <div class="row g-3">
                <div class="col-12">
                  {{ form_row(form.old_password, {
                    label: 'Ancien mot de passe',
                    row_attr: { class: 'mb-0' },
                    attr: { class: 'form-control', autocomplete: 'current-password' }
                  }) }}
                </div>

                <div class="col-12 col-md-6">
                  {{ form_row(form.new_password, {
                    label: 'Nouveau mot de passe',
                    row_attr: { class: 'mb-0' },
                    attr: { class: 'form-control', autocomplete: 'new-password' }
                  }) }}
                </div>

                <div class="col-12 col-md-6">
                  {{ form_row(form.new_password_retry, {
                    label: 'Confirmer le mot de passe',
                    row_attr: { class: 'mb-0' },
                    attr: { class: 'form-control', autocomplete: 'new-password' }
                  }) }}
                </div>

                <div class="col-12">
                  <div class="form-text">
                    Laisse les champs mot de passe vides si tu ne veux pas le modifier.
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-4">
              <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                Annuler
              </a>
              <button class="btn btn-primary" type="submit">
                Enregistrer
              </button>
            </div>

          {{ form_end(form) }}
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}