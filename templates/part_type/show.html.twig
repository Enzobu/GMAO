{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Type de pièce{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">{{ part_type.name }}</h1>
        <div class="text-body-secondary small">
          Détail du type de pièce.
        </div>
      </div>

      <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_configuration_part_type_index') }}">
          {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
          Retour
        </a>

        <a class="btn btn-primary" href="{{ path('app_configuration_part_type_edit', { id: part_type.id }) }}?show=true">
          {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
          Modifier
        </a>

        {{ include('part_type/_delete_form.html.twig', { part_type: part_type }) }}
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="row g-4">
          <div class="col-lg-6">
            <div class="text-body-secondary small">Nom</div>
            <div class="fw-semibold">{{ part_type.name }}</div>
          </div>

          <div class="col-12">
            <div class="text-body-secondary small">Description</div>
            <div>
              {{ part_type.description ?: 'Aucune description.' }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}