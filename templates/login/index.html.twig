<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
    {% block javascripts %}
      {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
  </head>
  <body>
    <div class="container">
      <div class="d-flex justify-content-center" style="height: 100vh;">
        <div class="row justify-content-center w-100 mt-5 pt-5">
          <div class="col-md-8 col-lg-6 col-xl-4 col-xxl-4 text-center">
            <h1 class="h3 mb-5 font-weight-normal">Connexion</h1>

            {% if error %}
              <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" data-turbo="false">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

              <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                <label class="mb-0 text-nowrap">E-mail :</label>
                <input
                  type="email"
                  name="login[email]"
                  value="{{ last_username }}"
                  class="form-control border-0 shadow-none"
                  required
                  autofocus
                >
              </div>

              <div class="d-flex align-items-center gap-2 mb-3 w-100 border rounded-pill px-3">
                <label class="mb-0 text-nowrap">Mot de passe :</label>
                <input
                  type="password"
                  name="login[password]"
                  class="form-control border-0 shadow-none"
                  required
                >
              </div>

              <div class="mt-3 text-end">
                <a href="{{ path('app_forgot_password_request') }}">
                  Mot de passe oublié ?
                </a>
              </div>

              <button class="btn btn-primary mt-3" type="submit" data-turbo="false">
                Se connecter
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
