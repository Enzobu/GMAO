{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/badge.html.twig' as badge %}

{% block title %}Entretiens du véhicule{% endblock %}

{% block body %}
  {% set readOnly = is_granted('ROLE_ADMIN') ? false : vehicle.user != app.user %}

  <div class="container py-4 py-lg-5">
    <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 mb-4">
      <div>
        <div class="text-body-secondary small mb-1">Véhicule</div>
        <h1 class="h3 mb-2">Entretiens ・ {{ vehicle.displayName }}</h1>
        <div class="text-body-secondary small">
          Historique des interventions rattachées à ce véhicule.
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_vehicle_show', {id: vehicle.id}) }}">
          {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
          Retour véhicule
        </a>

        <a
          class="btn btn-primary {{ readOnly ? 'btn-disable' }}"
          {% if not readOnly %}href="{{ path('app_vehicle_maintenance_new', {vehicleId: vehicle.id}) }}"{% endif %}
        >
          {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
          Ajouter un entretien
        </a>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        {% if maintenances|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Statut</th>
                  <th>Kilométrage</th>
                  <th>Prévu</th>
                  <th>Réalisé</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for maintenance in maintenances %}
                  <tr>
                    <td class="fw-semibold">
                      {{ maintenance.maintenanceType.name }}
                      {% if maintenance.isExternal %}
                        <div class="mt-1">
                          {{ badge.emphasis('Externe', 'info') }}
                        </div>
                      {% endif %}
                    </td>
                    <td>
                      {{ badge.emphasis(
                        label: maintenance.status.label,
                        variant: maintenance.status.variant
                      ) }}
                    </td>
                    <td>{{ maintenance.mileage is not null ? maintenance.mileage|number_format(0, ',', ' ') ~ ' km' : '—' }}</td>
                    <td>{{ maintenance.plannedAt ? maintenance.plannedAt|date('d/m/Y') : '—' }}</td>
                    <td>{{ maintenance.performedAt ? maintenance.performedAt|date('d/m/Y') : '—' }}</td>
                    <td>
                      <div class="d-flex justify-content-end gap-2">
                        <a
                          class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center p-2"
                          href="{{ path('app_vehicle_maintenance_show', {vehicleId: vehicle.id, id: maintenance.id}) }}"
                        >
                          {{ fa.icon('eye', family: 'solid', fixed_width: true) }}
                        </a>

                        <a
                          class="btn btn-sm btn-outline-primary {{ readOnly ? 'btn-outline-disable' }} d-flex align-items-center justify-content-center p-2"
                          {% if not readOnly %}href="{{ path('app_vehicle_maintenance_edit', {vehicleId: vehicle.id, id: maintenance.id}) }}"{% endif %}
                        >
                          {{ fa.icon('pen', family: 'solid', fixed_width: true) }}
                        </a>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="text-center py-5">
            <div class="mb-2">
              {{ fa.icon('screwdriver-wrench', family: 'solid', fixed_width: true, additional_classes: ['fs-3', 'text-body-secondary']) }}
            </div>
            <div class="fw-semibold">Aucun entretien</div>
            <div class="text-body-secondary small mb-3">
              Aucun entretien n’est rattaché à ce véhicule.
            </div>

            <a
              class="btn btn-primary {{ readOnly ? 'btn-disable' }}"
              {% if not readOnly %}href="{{ path('app_vehicle_maintenance_new', {vehicleId: vehicle.id}) }}"{% endif %}
            >
              {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
              Ajouter un entretien
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
