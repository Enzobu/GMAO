{% import "macros/fontawesome.html.twig" as fa %}

{{ form_start(form) }}
  <div class="row g-3">
    <div class="col-12 col-xl-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-body">
          <div class="fw-semibold">Informations utilisateur</div>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              {{ form_row(form.firstname) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.lastname) }}
            </div>
            <div class="col-12">
              {{ form_row(form.email) }}
            </div>
            <div class="col-12">
              {{ form_row(form.roles) }}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-body">
          <div class="fw-semibold">Adresse</div>
        </div>

        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              {{ form_row(form.address.line1) }}
            </div>
            <div class="col-12">
              {{ form_row(form.address.line2) }}
            </div>
            <div class="col-12 col-md-4">
              {{ form_row(form.address.postalCode) }}
            </div>
            <div class="col-12 col-md-4">
              {{ form_row(form.address.city) }}
            </div>
            <div class="col-12 col-md-4">
              {{ form_row(form.address.country) }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-3">
    <a class="btn btn-outline-secondary me-2" href="{{ path('app_user_index') }}">
      {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
      Retour
    </a>
    <button class="btn btn-primary">
      {{ fa.icon('floppy-disk', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
      {{ button_label|default('Enregistrer') }}
    </button>
  </div>
{{ form_end(form) }}