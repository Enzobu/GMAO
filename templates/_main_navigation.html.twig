{% import "macros/navigation.html.twig" as navigation %}
{% import "macros/fontawesome.html.twig" as fa %}

{{ navigation.sidebar_item(
    label: 'Accueil',
    path: path('app_home'),
    icon: fa.icon('house', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
    check_paths: ['app_home'],
) }}

<hr>

{{ navigation.sidebar_item(
    label: 'Véhicules',
    path: path('app_vehicle_index'),
    icon: fa.icon('car-side', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
    check_paths: ['app_vehicle_'],
) }}

<hr>

{{ navigation.sidebar_item(
    label: 'Interventions',
    path: path('app_maintenance_index'),
    icon: fa.icon('screwdriver-wrench', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
    check_paths: ['app_maintenance_'],
) }}

<hr>

{{ navigation.sidebar_item(
    label: 'Stock',
    path: path('app_part_index'),
    icon: fa.icon('warehouse', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
    check_paths: ['app_part_'],
) }}

<hr>

{{ navigation.sidebar_item(
    label: 'Utilisateurs',
    path: path('app_user_index'),
    icon: fa.icon('user', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
    check_paths: ['app_user_'],
) }}

{% if is_granted('ROLE_ADMIN') %}
  {% set configuration_open = app.request.attributes.get('_route') starts with 'app_configuration_' %}

  <button
    class="mt-4 btn btn-link text-decoration-none text-start w-100 d-flex align-items-center justify-content-between px-0 py-2 {% if configuration_open %}fw-semibold{% endif %}"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#sidebarConfiguration"
    aria-expanded="{{ configuration_open ? 'true' : 'false' }}"
    aria-controls="sidebarConfiguration"
  >
    <span class="d-inline-flex align-items-center">
      {{ fa.icon('gear', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
      Configuration
    </span>

    {{ fa.icon(
      configuration_open ? 'chevron-up' : 'chevron-down',
      family: 'solid',
      fixed_width: true
    ) }}
  </button>

  <div class="collapse {% if configuration_open %}show{% endif %}" id="sidebarConfiguration">
    <div class="ps-3 pt-2 d-flex flex-column gap-2">
      {{ navigation.sidebar_item(
        label: 'Types de pièces',
        path: path('app_configuration_part_type_index'),
        icon: fa.icon('atom', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
        check_paths: ['app_configuration_part_type_'],
      ) }}

      {{ navigation.sidebar_item(
        label: 'Types d’entretiens',
        path: path('app_configuration_maintenance_type_index'),
        icon: fa.icon('screwdriver-wrench', family: 'solid', fixed_width: true, additional_classes: ['me-2']),
        check_paths: ['app_configuration_maintenance_type_'],
      ) }}
    </div>
  </div>
{% endif %}
