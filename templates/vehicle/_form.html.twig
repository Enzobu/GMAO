{{ form_start(form) }}

<div class="card shadow-sm">
  <div class="card-header bg-body d-flex align-items-center justify-content-between">
    <div class="fw-semibold">Informations du véhicule</div>
    <div class="text-body-secondary small">Champs optionnels autorisés</div>
  </div>

  <div class="card-body">
    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="border rounded p-3 h-100">
          <div class="fw-semibold mb-3">Identité</div>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              {{ form_row(form.name) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.registration) }}
            </div>

            <div class="col-12 col-md-6">
              {{ form_row(form.brand) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.model) }}
            </div>

            <div class="col-12 col-md-6">
              {{ form_row(form.type) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.status) }}
            </div>

            {% if form.user is defined %}
              <div class="col-12">
                {{ form_row(form.user) }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="border rounded p-3 h-100">
          <div class="fw-semibold mb-3">Caractéristiques</div>

          <div class="row g-3">
            <div class="col-12 col-md-4">
              {{ form_row(form.year) }}
            </div>
            <div class="col-12 col-md-4">
              {{ form_row(form.fuelType) }}
            </div>
            <div class="col-12 col-md-4">
              {{ form_row(form.transmission) }}
            </div>

            <div class="col-12 col-md-6">
              {{ form_row(form.lastMileage) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.color) }}
            </div>

            <div class="col-12 col-md-6">
              {{ form_row(form.vin) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.engine) }}
            </div>
          </div>
        </div>
      </div>

      <div class="col-12">
        <div class="border rounded p-3">
          <div class="fw-semibold mb-3">Achat et suivi</div>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              {{ form_row(form.purchaseDate) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_row(form.purchasePrice) }}
            </div>
          </div>
        </div>
      </div>
    </div>

    {{ form_rest(form) }}
  </div>

  <div class="card-footer bg-body d-flex justify-content-end gap-2">
    <a 
      class="btn btn-outline-secondary" 
      href="{{ 
        app.request.query.get('show') == 'true' ? 
        path('app_vehicle_show', {id: vehicle.id}) : 
        path('app_vehicle_index') 
      }}"
    >
      Annuler
    </a>
    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
  </div>
</div>

{{ form_end(form) }}