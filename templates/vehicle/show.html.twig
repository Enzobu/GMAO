{% extends 'base.html.twig' %}
{% import "macros/badge.html.twig" as badge %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import 'macros/document.html.twig' as document %}

{% block title %}Véhicule{% endblock %}

{% block body %}
  {% set readOnly = is_granted('ROLE_ADMIN') ? false : vehicle.user != app.user %}
  <div class="mb-4">
    <div class="d-flex flex-column gap-3">
      <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3">
        <div class="flex-grow-1 min-w-0">
          <h1 class="h3 mb-2">
            {{ vehicle.name|capitalize ?: (vehicle.brand|capitalize ~ ' ' ~ vehicle.model|capitalize)|trim }}
          </h1>

          {# Desktop uniquement #}
          <div class="d-none d-lg-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              {% if vehicle.type %}
                {{ badge.emphasis(label: vehicle.type.label, variant: vehicle.type.variant ) }}
              {% endif %}

              {{ badge.emphasis(label: vehicle.status.label, variant: vehicle.status.variant ) }}
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap text-body-secondary">
              <span><strong>Immat.</strong> {{ vehicle.registration|upper }}</span>

              {% if vehicle.year %}
                <span><strong>Année</strong> {{ vehicle.year }}</span>
              {% endif %}

              {% if vehicle.lastMileage is not null %}
                <span><strong>Km</strong> {{ vehicle.lastMileage|number_format(0, '.', ' ') }}</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 flex-shrink-0">
          <a class="btn btn-outline-secondary" href="{{ path('app_vehicle_index') }}">
            {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
            Retour
          </a>

          <a
            class="btn btn-primary {{ readOnly ? 'btn-disable' }}"
            {% if not readOnly %}href="{{ path('app_vehicle_edit', {id: vehicle.id}) }}?show=true"{% endif %}
          >
            {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
            Modifier
          </a>

          {% if is_granted('ROLE_ADMIN') %}
            {% include "vehicle/_delete_form.html.twig" %}
          {% endif %}
        </div>
      </div>

      {# Mobile / tablette : on garde uniquement le nom, donc rien ici #}
    </div>
  </div>

  <div class="row g-3">
    <h3 class="fw-semibold mb-2">Informations générales</h3>
    {# ---- Carte : Identité ---- #}
    <div class="col-12 col-xl-6">
      <div class="card shadow-sm">
        <div class="card-header bg-body">
          <div class="fw-semibold">Identité</div>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4 text-body-secondary">Nom</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.name|capitalize }}</dd>

            <dt class="col-sm-4 text-body-secondary">Marque</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.brand|capitalize }}</dd>

            <dt class="col-sm-4 text-body-secondary">Modèle</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.model|capitalize }}</dd>

            <dt class="col-sm-4 text-body-secondary">Immatriculation</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.registration|upper }}</dd>

            <dt class="col-sm-4 text-body-secondary">Type</dt>
            <dd class="col-sm-8 mb-2">
              {{ vehicle.type ? vehicle.type.label : '—' }}
            </dd>

            <dt class="col-sm-4 text-body-secondary">Statut</dt>
            <dd class="col-sm-8 mb-0">
              {{ vehicle.status.label }}
            </dd>
          </dl>
        </div>
      </div>
    </div>

    {# ---- Carte : Techniques ---- #}
    <div class="col-12 col-xl-6">
      <div class="card shadow-sm">
        <div class="card-header bg-body">
          <div class="fw-semibold">Caractéristiques</div>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4 text-body-secondary">Année</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.year ?: '—' }}</dd>

            <dt class="col-sm-4 text-body-secondary">VIN</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.vin ?: '—' }}</dd>

            <dt class="col-sm-4 text-body-secondary">Moteur</dt>
            <dd class="col-sm-8 mb-2">{{ vehicle.engine ?: '—' }}</dd>

            <dt class="col-sm-4 text-body-secondary">Carburant</dt>
            <dd class="col-sm-8 mb-2">
              {{ vehicle.fuelType ? vehicle.fuelType.label : '—' }}
            </dd>

            <dt class="col-sm-4 text-body-secondary">Transmission</dt>
            <dd class="col-sm-8 mb-2">
              {{ vehicle.transmission ? vehicle.transmission.label : '—' }}
            </dd>

            <dt class="col-sm-4 text-body-secondary">Couleur</dt>
            <dd class="col-sm-8 mb-0">{{ vehicle.color.label ?: '—' }}</dd>
          </dl>
        </div>
      </div>
    </div>

    {# ---- Carte : Achat / suivi ---- #}
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-body">
          <div class="fw-semibold">Achat et suivi</div>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="text-body-secondary small">Date d’achat</div>
                <div class="fs-5">
                  {{ vehicle.purchaseDate ? vehicle.purchaseDate|date('d/m/Y') : '—' }}
                </div>
              </div>
            </div>

            <div class="col-12 col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="text-body-secondary small">Prix d’achat</div>
                <div class="fs-5">
                  {% if vehicle.purchasePrice %}
                    {{ vehicle.purchasePrice }} €
                  {% else %}
                    —
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="col-12 col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="text-body-secondary small">Dernier kilométrage</div>
                <div class="fs-5">
                  {{ vehicle.lastMileage is not null ? vehicle.lastMileage ~ ' km' : '—' }}
                </div>
              </div>
            </div>
          </div>

          <hr class="my-4">

          <div class="text-body-secondary small">
            Propriétaire :
            <strong>{{ vehicle.user.firstname|capitalize }} {{ vehicle.user.lastname|upper }}</strong>
            <span class="ms-2">
              (
                <a href="mailto:{{ vehicle.user.email }}">{{ vehicle.user.email }}</a>
              )
            </span>
          </div>
        </div>
      </div>
    </div>

    <h3 class="fw-semibold mt-4 mb-2">Assurance & Controle technique</h3>
    {# ---- Placeholder : blocs à venir ---- #}
    <div class="col-12 col-xl-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-body d-flex align-items-center justify-content-between">
          <div class="fw-semibold">
            <span>
              Assurance ・
              <a href="{{ path('app_vehicle_insurance_index', {vehicleId: vehicle.id}) }}">
                {{ fa.icon(name: 'arrow-up-right-from-square', family: 'solid', size: 'sm') }}
              </a>
            </span>
          </div>
          {{ badge.emphasis(label: 'Last', variant: 'info') }}
        </div>

        <div class="card-body">
          {% if insurance is null %}
            <div class="text-body-secondary">
              Aucune assurance renseignée.
            </div>
          {% else %}
            <div class="row gy-3">
              <div class="col-12">
                <div class="small text-body-secondary mb-1">Assureur</div>
                <div class="fw-semibold">{{ insurance.providerName }}</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Numéro de police</div>
                <div>{{ insurance.policyNumber ?: '—' }}</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Statut</div>
                <div>
                  {% if insurance.isActive %}
                    {{ badge.emphasis(label: 'Active', variant: 'success') }}
                  {% else %}
                    {{ badge.emphasis(label: 'Inactive', variant: 'secondary') }}
                  {% endif %}
                </div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Début</div>
                <div>{{ insurance.startDate ? insurance.startDate|date(date_format) : '—' }}</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Fin</div>
                <div>{{ insurance.endDate ? insurance.endDate|date(date_format) : '—' }}</div>
              </div>

              <div class="col-12">
                <div class="small text-body-secondary mb-1">Fréquence de paiement</div>
                <div>{{ insurance.paymentFrequency.label() }}</div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-body d-flex align-items-center justify-content-between">
          <div class="fw-semibold">
            <span>
              Contrôle technique ・
              <a href="{{ path('app_vehicle_inspection_index', {vehicleId: vehicle.id}) }}">
                {{ fa.icon(name: 'arrow-up-right-from-square', family: 'solid', size: 'sm') }}
              </a>
            </span>
          </div>
          {{ badge.emphasis(label: 'Last', variant: 'info') }}
        </div>

        <div class="card-body">
          {% if inspection is null %}
            <div class="text-body-secondary">
              Aucun contrôle technique renseigné.
            </div>
          {% else %}
            <div class="row gy-3">
              <div class="col-12">
                <div class="small text-body-secondary mb-1">Résultat</div>
                <div>
                  {% set resultVariant = 'secondary' %}
                  {% if inspection.result is not null %}
                    {% if inspection.result.value == 'pass' %}
                      {% set resultVariant = 'success' %}
                    {% elseif inspection.result.value == 'counter_visit' %}
                      {% set resultVariant = 'warning' %}
                    {% elseif inspection.result.value == 'fail' %}
                      {% set resultVariant = 'danger' %}
                    {% endif %}
                  {% endif %}

                  {{ badge.emphasis(label: inspection.result ? inspection.result.label() : 'Non renseigné', variant: resultVariant) }}
                </div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Date du contrôle</div>
                <div>{{ inspection.inspectionDate ? inspection.inspectionDate|date(date_format) : '—' }}</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Valide jusqu’au</div>
                <div>{{ inspection.validUntil ? inspection.validUntil|date(date_format) : '—' }}</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Kilométrage</div>
                <div>{{ inspection.mileage is not null ? inspection.mileage ~ ' km' : '—' }}</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Contre-visite</div>
                <div>
                  {% if inspection.counterVisitRequired %}
                    {{ badge.emphasis(label: 'Requise', variant: 'danger') }}

                  {% else %}
                    {{ badge.emphasis(label: "Non requise", variant: 'success') }}
                  {% endif %}
                </div>
              </div>

              {% if inspection.counterVisitRequired %}
                <div class="col-12">
                  <div class="small text-body-secondary mb-1">Date limite contre-visite</div>
                  <div>{{ inspection.counterVisitDueAt ? inspection.counterVisitDueAt|date(date_format) : '—' }}</div>
                </div>
              {% endif %}

              <div class="col-12">
                <div class="small text-body-secondary mb-1">Centre</div>
                <div>{{ inspection.center.name ?? 'Non renseigné' }}</div>
              </div>

              {% if inspection.notes %}
                <div class="col-12">
                  <div class="small text-body-secondary mb-1">Notes</div>
                  <div class="lh-sm">{{ inspection.notes }}</div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <h3 class="fw-semibold mt-4 mb-2">Entretien</h3>
    <div class="col-12">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-body d-flex align-items-center justify-content-between">
          <div class="fw-semibold">
            <span>
              Dernier entretien ・
              <a href="{{ path('app_maintenance_index', {vehicle: vehicle.id}) }}">
                {{ fa.icon(name: 'arrow-up-right-from-square', family: 'solid', size: 'sm') }}
              </a>
            </span>
          </div>
          {{ badge.emphasis(label: 'Dernier réalisé', variant: 'info') }}
        </div>

        <div class="card-body">
          {% if latest_maintenance is null %}
            <div class="text-body-secondary">
              Aucun entretien réalisé.
            </div>
          {% else %}
            <div class="row gy-3">
              <div class="col-12">
                <div class="small text-body-secondary mb-1">Type</div>
                <div>
                  {{ badge.emphasis(label: latest_maintenance.maintenanceType.label, variant: 'info') }}
                </div>
              </div>

              <div class="col-12 col-md-6 col-xl-3">
                <div class="small text-body-secondary mb-1">Statut</div>
                <div>
                  {{ badge.emphasis(
                    label: latest_maintenance.status.label,
                    variant: latest_maintenance.status.variant
                  ) }}
                </div>
              </div>

              <div class="col-12 col-md-6 col-xl-3">
                <div class="small text-body-secondary mb-1">Réalisé le</div>
                <div>{{ latest_maintenance.performedAt|date(date_format) }}</div>
              </div>

              <div class="col-12 col-md-6 col-xl-3">
                <div class="small text-body-secondary mb-1">Kilométrage</div>
                <div>{{ latest_maintenance.mileage is not null ? latest_maintenance.mileage|number_format(0, ',', ' ') ~ ' km' : '—' }}</div>
              </div>

              <div class="col-12 col-md-6 col-xl-3">
                <div class="small text-body-secondary mb-1">Mode</div>
                <div>
                  {{ badge.emphasis(
                    latest_maintenance.isExternal ? 'Externe' : 'Interne',
                    latest_maintenance.isExternal ? 'info' : 'secondary'
                  ) }}
                </div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Prochaine échéance kilométrique</div>
                <div>
                  {{ latest_maintenance.nextDueMileage is not null ? latest_maintenance.nextDueMileage|number_format(0, ',', ' ') ~ ' km' : '—' }}
                </div>
              </div>

              <div class="col-12 col-md-6">
                <div class="small text-body-secondary mb-1">Prochaine échéance date</div>
                <div>{{ latest_maintenance.nextDueAt ? latest_maintenance.nextDueAt|date(date_format) : '—' }}</div>
              </div>

              {% if latest_maintenance.notes %}
                <div class="col-12">
                  <div class="small text-body-secondary mb-1">Notes</div>
                  <div class="lh-sm">{{ latest_maintenance.notes }}</div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {{ document.list
      (
        documents: vehicle_document, 
        newPath: path('app_vehicle_document_new', {id: vehicle.id}),
        sourceRoute: path(app.request.attributes.get('_route'), {id: vehicle.id}),
        editRoute: 'app_vehicle_document_edit',
        editParameters: {id: vehicle.id},
        deleteRoute: 'app_vehicle_document_delete',
        deleteParameters: {id: vehicle.id},
        fallback: "Aucun document disponible pour ce véhicule",
        readOnly: readOnly,
      )
    }}
  </div>
{% endblock %}
