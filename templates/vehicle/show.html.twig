{% extends 'base.html.twig' %}

{% block title %}Vehicle{% endblock %}

{% block body %}
    <h1>Vehicle</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ vehicle.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ vehicle.name }}</td>
            </tr>
            <tr>
                <th>Registration</th>
                <td>{{ vehicle.registration }}</td>
            </tr>
            <tr>
                <th>Brand</th>
                <td>{{ vehicle.brand }}</td>
            </tr>
            <tr>
                <th>Model</th>
                <td>{{ vehicle.model }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ vehicle.type }}</td>
            </tr>
            <tr>
                <th>Year</th>
                <td>{{ vehicle.year }}</td>
            </tr>
            <tr>
                <th>Vin</th>
                <td>{{ vehicle.vin }}</td>
            </tr>
            <tr>
                <th>Engine</th>
                <td>{{ vehicle.engine }}</td>
            </tr>
            <tr>
                <th>FuelType</th>
                <td>{{ vehicle.fuelType }}</td>
            </tr>
            <tr>
                <th>Transmission</th>
                <td>{{ vehicle.transmission }}</td>
            </tr>
            <tr>
                <th>LastMileage</th>
                <td>{{ vehicle.lastMileage }}</td>
            </tr>
            <tr>
                <th>Color</th>
                <td>{{ vehicle.color }}</td>
            </tr>
            <tr>
                <th>PurchaseDate</th>
                <td>{{ vehicle.purchaseDate ? vehicle.purchaseDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>PurchasePrice</th>
                <td>{{ vehicle.purchasePrice }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ vehicle.status }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_vehicle_index') }}">back to list</a>

    <a href="{{ path('app_vehicle_edit', {'id': vehicle.id}) }}">edit</a>

    {{ include('vehicle/_delete_form.html.twig') }}
{% endblock %}
