{% import 'macros/modal.html.twig' as modal %}
{% import 'macros/fontawesome.html.twig' as fa %}

<button type="button"
  class="btn btn-outline-danger"
  data-bs-toggle="modal"
  data-bs-target="#deleteVehicleModal{{ vehicle.id }}"
>
  {{ fa.icon('trash-can', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
  Supprimer
</button>

{{ modal.confirm(
  id: 'deleteVehicleModal' ~ vehicle.id,
  title: 'Supprimer le véhicule',
  description: '
    <p class="mb-2">Vous êtes sur le point de supprimer ce véhicule :</p>
    <div class="fw-semibold">' ~
      (vehicle.name ?: ((vehicle.brand ?: '') ~ ' ' ~ (vehicle.model ?: ''))|trim)
    ~ '</div>
    <div class="small text-body-secondary mt-1">' ~ vehicle.registration|upper ~ '</div>
    <p class="mt-3 mb-0 text-danger">Cette action est définitive.</p>
  ',
  continueButton: 'Supprimer',
  cancelButton: 'Annuler',
  type: 'submit',
  accent: 'danger',
  action: path('app_vehicle_delete', {'id': vehicle.id}),
  csrfToken: csrf_token('delete' ~ vehicle.id)
) }}