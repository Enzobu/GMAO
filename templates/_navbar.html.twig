{% import "macros/dropdown.html.twig" as dropdown %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/navigation.html.twig" as navigation %}

<header class="sticky-top">
  <nav class="navbar navbar-expand-lg bg-body border-bottom shadow-sm" id="main-navbar">
    <div class="container">
      {# ----- Logo ----- #}
      <a class="navbar-brand me-5" href="{{ path('app_home') }}" aria-label="Accueil">
        <p class="fs-4 p-0 m-0">GMAO</p>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        {# ----- Bouton de gauche ----- #}
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          {# {{ navigation.nav_item(
            label: 'Évènements',
            path: path('app_event_index'),
            icon: fa.icon('calendar-star', size: 'lg'),
            check_path: 'app_event',
          ) }} #}
        </ul>

        {# ----- Bouton de droite ----- #}
        {% if is_granted('ROLE_USER') %}
          <ul class="navbar-nav">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ currentUser.firstname|slice(0, 1) }}{{ currentUser.lastname|slice(0, 1) }}
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                {{ dropdown.item(
                  label: 'Profil',
                  path: path('app_home'),
                  icon: fa.icon('user', fixed_width: true),
                ) }}

                {# {% if is_granted('ROLE_ADMIN') %}
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  
                  {{ dropdown.item(
                    label: 'Plans',
                    path: path('app_admin_plan_index'),
                    icon: fa.icon('face-tongue-money', fixed_width: true),
                  ) }}
                {% endif %} #}
                
                <li>
                  <hr class="dropdown-divider" />
                </li>
                
                {{ dropdown.item(
                  label: 'Déconnexion',
                  path: path('app_logout'),
                  icon: fa.icon('right-from-bracket', fixed_width: true),
                  destructive: true,
                ) }}
              </ul>
            </li>
          </ul>
        {% endif %}
      </div>
    </div>
  </nav>
</header>