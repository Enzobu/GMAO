{{ form_start(form, {
    attr: {
      'data-turbo': 'false'
    }
}) }}
  {% set route = app.request.attributes.get('_route') %}
  <div class="row g-3">
    {% if 
      not (route == 'app_vehicle_document_edit' or
      route == 'app_vehicle_insurance_document_edit' or
      route == 'app_vehicle_inspection_document_edit' or
      route == 'app_profile_document_edit')
    %}
      <div class="col-12">
        {{ form_row(form.file) }}
      </div>
    {% endif %}
    
    <div class="col-12">
      {{ form_row(form.name) }}
    </div>
    <div class="col-12">
      {{ form_row(form.description) }}
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mt-4">
    <a
      href="{{ app.request.query.get('sourceRoute') }}"
      class="btn btn-sm btn-outline-secondary"
    >
      Annuler
    </a>
    <button type="submit" class="btn btn-sm btn-primary">
      Enregistrer
    </button>
  </div>
{{ form_end(form) }}