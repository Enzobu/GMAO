{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/badge.html.twig' as badge %}

{% block title %}Types d’entretiens{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">Types d’entretiens</h1>
        <div class="text-body-secondary small">
          Configuration des catégories d’interventions utilisées dans les entretiens.
        </div>
      </div>

      <a class="btn btn-primary" href="{{ path('app_configuration_maintenance_type_new') }}">
        {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
        Ajouter un type
      </a>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        {% if maintenance_types|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Nom</th>
                  <th>Description</th>
                  <th>Statut</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for maintenance_type in maintenance_types %}
                  <tr>
                    <td class="fw-semibold">{{ maintenance_type.name }}</td>
                    <td class="text-body-secondary">{{ maintenance_type.description ?: '—' }}</td>
                    <td>
                      {{ badge.emphasis(
                        maintenance_type.deleted ? 'Supprimé' : 'Actif',
                        maintenance_type.deleted ? 'secondary' : 'success'
                      ) }}
                    </td>
                    <td>
                      <div class="d-flex justify-content-end gap-2">
                        <a
                          class="btn btn-sm btn-outline-secondary"
                          href="{{ path('app_configuration_maintenance_type_show', { id: maintenance_type.id }) }}"
                        >
                          {{ fa.icon('eye', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
                          Voir
                        </a>

                        <a
                          class="btn btn-sm btn-outline-primary"
                          href="{{ path('app_configuration_maintenance_type_edit', { id: maintenance_type.id }) }}"
                        >
                          {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
                          Modifier
                        </a>

                        {% if not maintenance_type.deleted %}
                          {{ include('maintenance_type/_delete_form.html.twig', { maintenance_type: maintenance_type }) }}
                        {% endif %}
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="text-center py-5">
            <div class="mb-2">
              {{ fa.icon('screwdriver-wrench', family: 'solid', fixed_width: true, additional_classes: ['fs-3', 'text-body-secondary']) }}
            </div>

            <div class="fw-semibold">Aucun type d’entretien</div>

            <div class="text-body-secondary small mb-3">
              Commence par créer un type d’entretien.
            </div>

            <a class="btn btn-primary" href="{{ path('app_configuration_maintenance_type_new') }}">
              {{ fa.icon('plus', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
              Ajouter un type
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
