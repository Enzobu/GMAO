{% extends 'base.html.twig' %}

{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/badge.html.twig' as badge %}

{% block title %}Assurances{% endblock %}

{% block body %}
  <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Assurances du véhicule</h1>
      <div class="text-body-secondary">
        {{ vehicle_insurances|length }} assurance(s) enregistrée(s)
      </div>
    </div>

    <div class="d-flex gap-2">
      <a href="{{ path('app_vehicle_show', { id: vehicle.id }) }}" class="btn btn-outline-secondary">
        Retour au véhicule
      </a>

      {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_vehicle_insurance_new', { vehicleId: vehicle.id }) }}" class="btn btn-primary">
          {{ fa.icon(name: 'plus', family: 'solid', size: 'sm') }}
          Ajouter une assurance
        </a>
      {% endif %}
    </div>
  </div>

  {% if vehicle_insurances is empty %}
    <div class="card shadow-sm">
      <div class="card-body py-4 text-body-secondary">
        Aucune assurance trouvée pour ce véhicule.
      </div>
    </div>
  {% else %}
    <div class="d-flex flex-column gap-3">
      {% for vehicle_insurance in vehicle_insurances %}
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="d-flex flex-column flex-xl-row align-items-xl-start justify-content-between gap-3">
              <div class="flex-grow-1 min-w-0">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mb-2">
                  <h2 class="h5 mb-0">
                    {{ vehicle_insurance.providerName }}
                  </h2>

                  {% if vehicle_insurance.isActive %}
                    {{ badge.emphasis(label: 'Active', variant: 'success') }}
                  {% else %}
                    {{ badge.default(label: 'Inactive', variant: 'secondary') }}
                  {% endif %}

                  {{ badge.default(
                    label: vehicle_insurance.paymentFrequency.label(),
                    variant: 'info'
                  ) }}
                </div>

                <div class="row g-3">
                  <div class="col-12 col-md-6 col-xl-3">
                    <div class="small text-body-secondary mb-1">Numéro de police</div>
                    <div>{{ vehicle_insurance.policyNumber ?: '—' }}</div>
                  </div>

                  <div class="col-12 col-md-6 col-xl-3">
                    <div class="small text-body-secondary mb-1">Date de début</div>
                    <div>{{ vehicle_insurance.startDate ? vehicle_insurance.startDate|date(date_format) : '—' }}</div>
                  </div>

                  <div class="col-12 col-md-6 col-xl-3">
                    <div class="small text-body-secondary mb-1">Date de fin</div>
                    <div>{{ vehicle_insurance.endDate ? vehicle_insurance.endDate|date(date_format) : '—' }}</div>
                  </div>

                  <div class="col-12 col-md-6 col-xl-3">
                    <div class="small text-body-secondary mb-1">Dernière mise à jour</div>
                    <div>{{ vehicle_insurance.updatedAt ? vehicle_insurance.updatedAt|date(date_format) : '—' }}</div>
                  </div>
                </div>
              </div>

              <div class="d-flex flex-row flex-xl-column gap-2 flex-shrink-0">
                <a
                  href="{{ path('app_vehicle_insurance_show', { vehicleId: vehicle.id, id: vehicle_insurance.id }) }}"
                  class="btn btn-sm btn-outline-secondary"
                >
                  Voir
                </a>
                <a
                  href="{{ path('app_vehicle_insurance_edit', { vehicleId: vehicle.id, id: vehicle_insurance.id }) }}"
                  class="btn btn-sm btn-outline-primary"
                >
                  Modifier
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                  {% include "vehicle_insurance/_delete_form.html.twig" %}
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}