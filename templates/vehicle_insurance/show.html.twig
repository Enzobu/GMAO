{% extends 'base.html.twig' %}

{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/badge.html.twig' as badge %}
{% import 'macros/document.html.twig' as document %}

{% block title %}Assurance{% endblock %}

{% block body %}

  <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">{{ vehicle_insurance.providerName }}</h1>
      <div class="text-body-secondary">
        Détails de l'assurance
      </div>
    </div>

    <div class="d-flex gap-2">
      <a href="{{ path('app_vehicle_insurance_index', { vehicleId: vehicle.id }) }}" class="btn btn-outline-secondary">
        Retour
      </a>
      <a href="{{ path('app_vehicle_insurance_edit', { vehicleId: vehicle.id, id: vehicle_insurance.id }) }}?show=true" class="btn btn-primary">
        {{ fa.icon(name: 'pen', family: 'solid', size: 'sm') }}
        Modifier
      </a>

      {% if is_granted('ROLE_ADMIN') %}
        {% include "vehicle_insurance/_delete_form.html.twig" %}
      {% endif %}
    </div>
  </div>


  <h3 class="fw-semibold mb-2">Informations générales</h3>
  <div class="card shadow-sm">
    <div class="card-body">

      <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mb-4">
        {% if vehicle_insurance.isActive %}
          {{ badge.emphasis(label: 'Active', variant: 'success') }}
        {% else %}
          {{ badge.default(label: 'Inactive', variant: 'secondary') }}
        {% endif %}

        {{ badge.default(
          label: vehicle_insurance.paymentFrequency.label(),
          variant: 'info'
        ) }}
      </div>


      <div class="row g-4">

        <div class="col-12 col-md-6 col-xl-3">
          <div class="small text-body-secondary mb-1">Assureur</div>
          <div class="fw-semibold">{{ vehicle_insurance.providerName }}</div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
          <div class="small text-body-secondary mb-1">Numéro de police</div>
          <div>{{ vehicle_insurance.policyNumber ?: '—' }}</div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
          <div class="small text-body-secondary mb-1">Date de début</div>
          <div>
            {{ vehicle_insurance.startDate
              ? vehicle_insurance.startDate|date(date_format)
              : '—'
            }}
          </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
          <div class="small text-body-secondary mb-1">Date de fin</div>
          <div>
            {{ vehicle_insurance.endDate
              ? vehicle_insurance.endDate|date(date_format)
              : '—'
            }}
          </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
          <div class="small text-body-secondary mb-1">Créé le</div>
          <div>
            {{ vehicle_insurance.createdAt
              ? vehicle_insurance.createdAt|date(date_format)
              : '—'
            }}
          </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
          <div class="small text-body-secondary mb-1">Dernière modification</div>
          <div>
            {{ vehicle_insurance.updatedAt
              ? vehicle_insurance.updatedAt|date(date_format)
              : '—'
            }}
          </div>
        </div>
      </div>
    </div>
  </div>

  {{ document.list
    (
      documents: vehicle_insurance.documents, 
      newPath: path('app_vehicle_insurance_document_new', {vehicleId: vehicle.id, id: vehicle_insurance.id}),
      sourceRoute: path(app.request.attributes.get('_route'), {vehicleId: vehicle.id, id: vehicle_insurance.id}),
      editRoute: 'app_vehicle_insurance_document_edit',
      editParameters: {vehicleId: vehicle.id, id: vehicle_insurance.id},
      deleteRoute: 'app_vehicle_insurance_document_delete',
      deleteParameters: {vehicleId: vehicle.id, id: vehicle_insurance.id},
      fallback: "Aucun document disponible pour cette assurance",
    )
  }}

{% endblock %}