{% import 'macros/modal.html.twig' as modal %}
{% import 'macros/fontawesome.html.twig' as fa %}

<button type="button"
  class="btn {{ width_sm ? "btn-sm" }} btn-outline-danger"
  data-bs-toggle="modal"
  data-bs-target="#deleteVehicleInsuranceModal{{ vehicle_insurance.id }}"
>
  {{ fa.icon('trash-can', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
  Supprimer
</button>

{{ modal.confirm(
  id: 'deleteVehicleInsuranceModal' ~ vehicle_insurance.id,
  title: 'Supprimer l’assurance',
  description: '
    <p class="mb-2">Vous êtes sur le point de supprimer cette assurance :</p>
    <div class="fw-semibold">' ~ vehicle_insurance.providerName ~ '</div>
    <div class="small text-body-secondary mt-1">' ~ (vehicle_insurance.policyNumber ?: 'Sans numéro de police') ~ '</div>
    <p class="mt-3 mb-0 text-danger">Cette action est définitive.</p>
  ',
  continueButton: 'Supprimer',
  cancelButton: 'Annuler',
  type: 'submit',
  accent: 'danger',
  action: path('app_vehicle_insurance_delete', { vehicleId: vehicle.id, id: vehicle_insurance.id }),
  csrfToken: csrf_token('delete' ~ vehicle_insurance.id)
) }}