{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}
{% import 'macros/badge.html.twig' as badge %}

{% block title %}Entretiens{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">Entretiens</h1>
        <div class="text-body-secondary small">
          Recherche et suivi global des entretiens des véhicules.
        </div>
      </div>
    </div>

    <form
      method="get"
      class="card border-0 shadow-sm mb-4"
      data-controller="auto-submit"
    >
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-4">
            <label for="q" class="form-label">Recherche</label>
            <input
              id="q"
              name="q"
              type="search"
              value="{{ searchQuery }}"
              class="form-control"
              placeholder="Véhicule, immatriculation, note…"
            >
          </div>

          <div class="col-12 col-lg-4">
            <label for="vehicle" class="form-label">Filtrer par véhicule</label>
            <select
              id="vehicle"
              name="vehicle"
              class="form-select"
              data-action="change->auto-submit#submit"
            >
              <option value="">Tous les véhicules</option>
              {% for vehicle in vehicles %}
                <option value="{{ vehicle.id }}" {{ selectedVehicleId == vehicle.id ? 'selected' }}>
                  {{ vehicle.displayName }}
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="col-12 col-md-6 col-lg-2">
            <label for="type" class="form-label">Type</label>
            <select
              id="type"
              name="type"
              class="form-select"
              data-action="change->auto-submit#submit"
            >
              <option value="">Tous</option>
              {% for maintenanceType in maintenance_types %}
                <option value="{{ maintenanceType.value }}" {{ selectedType == maintenanceType.value ? 'selected' }}>
                  {{ maintenanceType.label }}
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="col-12 col-md-6 col-lg-2">
            <label for="status" class="form-label">Statut</label>
            <select
              id="status"
              name="status"
              class="form-select"
              data-action="change->auto-submit#submit"
            >
              <option value="">Tous</option>
              {% for maintenanceStatus in maintenance_statuses %}
                <option value="{{ maintenanceStatus.value }}" {{ selectedStatus == maintenanceStatus.value ? 'selected' }}>
                  {{ maintenanceStatus.label }}
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="col-12 col-md-6 col-lg-3">
            <label for="sort" class="form-label">Trier par</label>
            <select
              id="sort"
              name="sort"
              class="form-select"
              data-action="change->auto-submit#submit"
            >
              <option value="createdAt" {{ selectedSort == 'createdAt' ? 'selected' }}>Création</option>
              <option value="performedAt" {{ selectedSort == 'performedAt' ? 'selected' }}>Date réalisée</option>
              <option value="plannedAt" {{ selectedSort == 'plannedAt' ? 'selected' }}>Date prévue</option>
              <option value="mileage" {{ selectedSort == 'mileage' ? 'selected' }}>Kilométrage</option>
              <option value="vehicle" {{ selectedSort == 'vehicle' ? 'selected' }}>Véhicule</option>
              <option value="status" {{ selectedSort == 'status' ? 'selected' }}>Statut</option>
              <option value="type" {{ selectedSort == 'type' ? 'selected' }}>Type</option>
            </select>
          </div>

          <div class="col-12 col-md-6 col-lg-3">
            <label for="direction" class="form-label">Ordre</label>
            <select
              id="direction"
              name="direction"
              class="form-select"
              data-action="change->auto-submit#submit"
            >
              <option value="DESC" {{ selectedDirection == 'DESC' ? 'selected' }}>Décroissant</option>
              <option value="ASC" {{ selectedDirection == 'ASC' ? 'selected' }}>Croissant</option>
            </select>
          </div>

          <div class="col-12 col-lg-auto">
            <button class="btn btn-primary w-100" type="submit">
              {{ fa.icon('magnifying-glass', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
              Rechercher
            </button>
          </div>

          <div class="col-12 col-lg-auto">
            <a class="btn btn-outline-secondary w-100" href="{{ path('app_maintenance_index') }}">
              {{ fa.icon('rotate-left', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
              Réinitialiser
            </a>
          </div>
        </div>
      </div>
    </form>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        {% if maintenances|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Véhicule</th>
                  <th>Type</th>
                  <th>Statut</th>
                  <th>Kilométrage</th>
                  <th>Prévu</th>
                  <th>Réalisé</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for maintenance in maintenances %}
                {% set canEdit = is_granted('ROLE_ADMIN') or maintenance.vehicle.user == app.user %}
                  <tr>
                    <td class="fw-semibold">
                      {{ maintenance.vehicle.displayName ?? '—' }}
                      {% if maintenance.vehicle.registration %}
                        <div class="text-body-secondary small">
                          {{ maintenance.vehicle.registration|upper }}
                        </div>
                      {% endif %}
                    </td>

                    <td>
                      {{ badge.emphasis(maintenance.maintenanceType.label ?? maintenance.maintenanceType.value ?? maintenance.maintenanceType, 'info') }}
                    </td>

                    <td>
                      {{ badge.emphasis(
                        label: maintenance.status.label,
                        variant: maintenance.status.variant
                      ) }}
                    </td>

                    <td>
                      {{ maintenance.mileage ? maintenance.mileage|number_format(0, ',', ' ') ~ ' km' : '—' }}
                    </td>

                    <td>
                      {{ maintenance.plannedAt ? maintenance.plannedAt|date('d/m/Y') : '—' }}
                    </td>

                    <td>
                      {{ maintenance.performedAt ? maintenance.performedAt|date('d/m/Y') : '—' }}
                    </td>

                    <td>
                      <div class="d-flex justify-content-end gap-2">
                        <a 
                          class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center p-2"
                          href="{{ path('app_maintenance_show', { id: maintenance.id }) }}"
                        >
                          {{ fa.icon('eye', family: 'solid', fixed_width: true) }}
                        </a>

                        <a
                          class="btn btn-sm btn-outline-primary {{ not canEdit ? 'btn-outline-disable' }} d-flex align-items-center justify-content-center p-2"
                          {% if canEdit %}
                            href="{{
                              is_granted('ROLE_ADMIN')
                                ? path('app_maintenance_edit', { id: maintenance.id })
                                : path('app_vehicle_maintenance_edit', { vehicleId: maintenance.vehicle.id, id: maintenance.id })
                            }}"
                          {% endif %}
                        >
                          {{ fa.icon('pen', family: 'solid', fixed_width: true) }}
                        </a>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="text-center py-5">
            <div class="mb-2">
              {{ fa.icon('wrench', family: 'solid', fixed_width: true, additional_classes: ['fs-3', 'text-body-secondary']) }}
            </div>

            <div class="fw-semibold">Aucun entretien</div>

            <div class="text-body-secondary small mb-3">
              Aucun entretien ne correspond aux filtres actuels.
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
