{% import 'macros/modal.html.twig' as modal %}
{% import 'macros/fontawesome.html.twig' as fa %}

<button type="button"
  class="btn btn-outline-danger"
  data-bs-toggle="modal"
  data-bs-target="#deleteMaintenanceModal{{ maintenance.id }}"
>
  {{ fa.icon('trash-can', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
  Supprimer
</button>

{{ modal.confirm(
  id: 'deleteMaintenanceModal' ~ maintenance.id,
  title: 'Supprimer l’entretien',
  description: '
    <p class="mb-2">Vous êtes sur le point de supprimer cet entretien :</p>
    <div class="fw-semibold">' ~ (maintenance.maintenanceType.label ?? maintenance.maintenanceType.value ?? maintenance.maintenanceType) ~ '</div>
    <div class="small text-body-secondary mt-1">' ~ (maintenance.vehicle.name ?? maintenance.vehicle.id) ~ '</div>
    <p class="mt-3 mb-0 text-danger">Cette action est définitive.</p>
  ',
  continueButton: 'Supprimer',
  cancelButton: 'Annuler',
  type: 'submit',
  accent: 'danger',
  action: path('app_maintenance_delete', {'id': maintenance.id}),
  csrfToken: csrf_token('delete' ~ maintenance.id)
) }}