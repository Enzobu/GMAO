{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Entretien{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h1 class="h3 mb-1">Détail de l’entretien</h1>
        <div class="text-body-secondary small">
          Consulte les informations de cet entretien.
        </div>
      </div>

      <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_maintenance_index') }}">
          {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
          Retour
        </a>
        <a class="btn btn-primary" href="{{ path('app_maintenance_edit', {'id': maintenance.id}) }}?show=true">
          {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-1']) }}
          Modifier
        </a>
        {{ include('maintenance/_delete_form.html.twig') }}
      </div>
    </div>

    <div class="row g-4">
      <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <h2 class="h5 mb-4">Informations générales</h2>

            <div class="row g-3">
              <div class="col-md-6">
                <div class="small text-body-secondary">Véhicule</div>
                <div class="fw-semibold">{{ maintenance.vehicle.name ?? 'Véhicule #' ~ maintenance.vehicle.id }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Type d’entretien</div>
                <div class="fw-semibold">{{ maintenance.maintenanceType.label ?? maintenance.maintenanceType.value ?? maintenance.maintenanceType }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Statut</div>
                <div class="fw-semibold">{{ maintenance.status.label ?? maintenance.status.value ?? maintenance.status }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Kilométrage</div>
                <div class="fw-semibold">{{ maintenance.mileage is not null ? maintenance.mileage|number_format(0, ',', ' ') ~ ' km' : '—' }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Prévu le</div>
                <div class="fw-semibold">{{ maintenance.plannedAt ? maintenance.plannedAt|date('d/m/Y H:i') : '—' }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Réalisé le</div>
                <div class="fw-semibold">{{ maintenance.performedAt ? maintenance.performedAt|date('d/m/Y H:i') : '—' }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Prochaine échéance kilométrique</div>
                <div class="fw-semibold">{{ maintenance.nextDueMileage is not null ? maintenance.nextDueMileage|number_format(0, ',', ' ') ~ ' km' : '—' }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Prochaine échéance date</div>
                <div class="fw-semibold">{{ maintenance.nextDueAt ? maintenance.nextDueAt|date('d/m/Y H:i') : '—' }}</div>
              </div>

              <div class="col-md-6">
                <div class="small text-body-secondary">Entretien externe</div>
                <div class="fw-semibold">{{ maintenance.isExternal ? 'Oui' : 'Non' }}</div>
              </div>

              <div class="col-12">
                <div class="small text-body-secondary">Notes</div>
                <div class="fw-semibold">{{ maintenance.notes ?: '—' }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <h2 class="h5 mb-4">Pièces utilisées</h2>

            {% if maintenance.maintenanceParts|length > 0 %}
              <div class="d-flex flex-column gap-3">
                {% for maintenancePart in maintenance.maintenanceParts %}
                  <div class="border rounded p-3 bg-body-tertiary">
                    <div class="fw-semibold">
                      {{ maintenancePart.part.partType.name }}
                    </div>
                    <div class="small text-body-secondary">
                      Quantité : {{ maintenancePart.quantity }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="text-body-secondary small">
                Aucune pièce renseignée.
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}