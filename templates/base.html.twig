<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GMAO - {% block title %}{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/logo.png') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
    {# <link rel="stylesheet" href="{{ asset('styles/app.css') }}"> #}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-..." crossorigin="anonymous"></script>
      {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
  </head>
  <body class="h-fit-content overflow-y-hidden p-0 m-0">
    {% include '_navbar.html.twig' %}
    {% set date_format = 'd/m/Y' %}

    <div class="row w-100 p-0 m-0 h-100">
      <div class="col-2 p-0 m-0 h-100">{% include '_sidebar.html.twig' %}</div>
      <div class="col-10 px-3 pt-2 pb-5 overflow-y-auto" style="max-height: 100%;">
        {% for label, messages in app.flashes %}
          {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
              {{ message }}
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
          {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
      </div>
    </div>
  </body>
</html>
