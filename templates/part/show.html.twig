{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Stock · {{ part.partType.name|capitalize }}{% endblock %}

{% block body %}
  <div class="container py-2 py-lg-3">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
      <div>
        <div class="text-body-secondary small mb-1">Stock</div>
        <h1 class="h3 mb-1">{{ part.partType.name|capitalize }}</h1>
        <div class="text-body-secondary small">
          Détail du stock et des véhicules compatibles.
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_part_index') }}">
          {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
          Retour
        </a>
        <a class="btn btn-primary" href="{{ path('app_part_edit', {id: part.id}) }}?show=true">
          {{ fa.icon('pen', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
          Modifier
        </a>
        {{ include('part/_delete_form.html.twig', { part: part }) }}
      </div>
    </div>

    <div class="row g-4">
      <div class="col-12 col-xl-8">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Informations</h2>

            <div class="row g-3">
              <div class="col-md-6">
                <div class="text-body-secondary small">Type de pièce</div>
                <div class="fw-semibold">{{ part.partType.name|capitalize }}</div>
              </div>

              <div class="col-md-6">
                <div class="text-body-secondary small">Quantité</div>
                <div 
                  class="fw-semibold {{ part.quantity == 0 ? 'text-danger' }}{{ part.quantity == 1 ? 'text-warning' }}"
                >
                  {{ part.quantity }}
                </div>
              </div>

              <div class="col-12">
                <div class="text-body-secondary small">Note</div>
                <div>
                  {{ part.note ?: 'Aucune note renseignée.' }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h2 class="h5 mb-3">Véhicules compatibles</h2>

            {% if part.vehicles|length > 0 %}
              <div class="d-flex flex-column gap-2">
                {% for vehicle in part.vehicles %}
                  <div class="border rounded px-3 py-2">
                    <div class="fw-semibold">{{ vehicle.name|capitalize ?: 'Véhicule #' ~ vehicle.id }}</div>
                    <div class="small text-body-secondary">
                      {{ vehicle.registration|upper ?: 'Immatriculation non renseignée' }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="text-body-secondary small">
                Aucun véhicule compatible renseigné.
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <h2 class="h5 mb-3">Traçabilité</h2>

            <div class="row g-3">
              <div class="col-md-6">
                <div class="text-body-secondary small">Créé le</div>
                <div class="fw-semibold">
                  {{ part.createdAt ? part.createdAt|date('d/m/Y à H:i') : '—' }}
                </div>
              </div>

              <div class="col-md-6">
                <div class="text-body-secondary small">Mis à jour le</div>
                <div class="fw-semibold">
                  {{ part.updatedAt ? part.updatedAt|date('d/m/Y à H:i') : '—' }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}