{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Modifier le stock{% endblock %}

{% block body %}
  <div class="container py-4 py-lg-5">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
      <div>
        <div class="text-body-secondary small mb-1">Stock</div>
        <h1 class="h3 mb-1">Modifier le stock</h1>
        <div class="text-body-secondary small">
          Mets à jour cette entrée de stock.
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a 
          class="btn btn-outline-secondary" 
          href="{{ 
            app.request.query.get('show') == 'true' ? 
            path('app_part_show', {id: part.id}) : 
            path('app_part_index') 
          }}"
        >
          {{ fa.icon('arrow-left', family: 'solid', fixed_width: true, additional_classes: ['me-2']) }}
          Retour
        </a>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        {{ include('part/_form.html.twig', { button_label: 'Enregistrer' }) }}
      </div>
    </div>
  </div>
{% endblock %}