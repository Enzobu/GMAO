{{ form_start(form) }}
  <div class="row g-3">
    {{ form_row(form.partType) }}
    {{ form_row(form.quantity) }}
    {{ form_row(form.vehicles) }}
    {{ form_row(form.note) }}
  </div>

  <div class="d-flex justify-content-end mt-4">
    <button class="btn btn-primary">
      {{ button_label|default('Enregistrer') }}
    </button>
  </div>
{{ form_end(form) }}